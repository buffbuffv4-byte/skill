* { font-family: "Segoe UI"; color: #f1f7f2; font-size: 10pt; }
QMainWindow, QWidget#pageStack, QWidget { background: #080d0a; }
QFrame#sidebar { background: #0c130e; border-right: 1px solid #1a2b20; }
QLabel#brand { color: #20e58a; font-size: 23pt; font-weight: 800; }
QLabel#muted { color: #91a99a; }
QLabel#sectionLabel { color: #527561; font-size: 8pt; font-weight: 700; padding-top: 8px; }
QLabel#pageTitle { font-size: 24pt; font-weight: 700; color: #f4fff7; }
QLabel#cardHeading { color: #a3bbaa; font-size: 10pt; font-weight: 600; }
QLabel#metricValue { color: #20e58a; font-size: 22pt; font-weight: 700; }
QFrame#card { background: #101a14; border: 1px solid #1b3325; border-radius: 13px; }
QPushButton#navButton { background: transparent; color: #a8b9ad; text-align: left; padding: 11px 10px; border: 0; border-radius: 8px; font-size: 10pt; }
QPushButton#navButton:hover { background: #14271b; color: #20e58a; }
QPushButton#primaryButton { background: #20e58a; color: #06120a; border: 0; border-radius: 8px; padding: 10px 16px; font-weight: 700; }
QPushButton#primaryButton:hover { background: #56f3a7; }
QPushButton#dangerButton { background: #46201f; color: #ffb8b2; border: 1px solid #73302c; border-radius: 8px; padding: 10px 16px; font-weight: 600; }
QPushButton#dangerButton:hover { background: #602925; }
QProgressBar { background: #1c2b21; border: 0; border-radius: 3px; }
QProgressBar::chunk { background: #20e58a; border-radius: 3px; }
QListWidget#resultsList { background: #0d1510; border: 1px solid #1b3325; border-radius: 10px; padding: 8px; }
QListWidget#resultsList::item { padding: 10px 8px; border-bottom: 1px solid #17251b; }
QListWidget#resultsList::item:selected { background: #173b27; color: #20e58a; }
QScrollBar:vertical { background: #0a100c; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #2a4834; border-radius: 4px; min-height: 25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QMessageBox { background: #101a14; }

QPushButton#secondaryButton { background: #17271c; color: #dcefe2; border: 1px solid #2a4a35; border-radius: 8px; padding: 10px 16px; font-weight: 600; }
QPushButton#secondaryButton:hover { background: #203b2a; color: #20e58a; }
